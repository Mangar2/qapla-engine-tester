Checks: 'modernize-*,-modernize-use-trailing-return-type,performance-*,-performance-enum-size,-performance-avoid-endl,readability-*,-readability-magic-numbers,-readability-identifier-length,-readability-math-missing-parentheses,-readability-redundant-member-init,bugprone-*,-bugprone-easily-swappable-parameters,cppcoreguidelines-narrowing-conversions'
WarningsAsErrors: false
HeaderFilterRegex: 'src/.*'

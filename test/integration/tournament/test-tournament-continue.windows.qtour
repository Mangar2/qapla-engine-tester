[each]
id=tournament
dir=.
proto=uci
tc=1+0.01
ponder=false
trace=none
restart=auto

[engine]
id=tournament
name=llt1
cmd=test/integration/engines/diagnostic-engine-lossontime.exe
dir=.
proto=uci
trace=none
restart=auto
tc=1.0+0.01

[engine]
id=tournament
name=llt2
cmd=test/integration/engines/diagnostic-engine-lossontime.exe
dir=.
proto=uci
trace=none
restart=auto
tc=1.0+0.01

[tournament]
id=tournament
type=round-robin
saveintervals=10
append=false
games=2
rounds=2
repeat=2
noswap=false
ratinginterval=100
averageelo=2600
outcomeinterval=0

[openings]
id=tournament
file=test/opening/book8ply.raw
order=sequential
srand=5489
plies=all
start=1
policy=default

[round]
id=tournament
round=1
engineA=llt1
engineB=llt2
games=01
wincauses=time forfeit:1
losscauses=time forfeit:1


[each]
id=sprt-tournament
dir=.
proto=uci
tc=5+0.01
ponder=false
trace=none
restart=auto

[engine]
id=sprt-tournament
name=llt1
cmd=C:\Development\qapla-engine-tester\test\integration\engines\diagnostic-engine-lossontime.exe
dir=.
proto=uci
trace=none
restart=auto
tc=5.0+0.01

[engine]
id=sprt-tournament
name=llt2
cmd=C:\Development\qapla-engine-tester\test\integration\engines\diagnostic-engine-lossontime.exe
dir=.
proto=uci
trace=none
restart=auto
tc=5.0+0.01

[sprt]
id=sprt-tournament
saveintervals=100
eloh0=0
eloh1=10
alpha=0.05
beta=0.05
maxgames=2
model=normalized
pentanomial=true
montecarlo=false

[openings]
id=sprt-tournament
file=test/opening/8ply-1000+-0,4+.pgn
order=sequential
srand=5489
plies=all
start=1
policy=default

[pgnoutput]
id=sprt-tournament
file=test/integration/log/parameter/test.pgn
append=false
finished=true
min=false
clock=true
eval=true
depth=true
pv=false

[draw]
id=sprt-tournament
active=false
movenumber=40
movecount=10
score=20
test=false

[resign]
id=sprt-tournament
active=false
movecount=10
score=600
twosided=true
test=false

[round]
id=sprt-tournament
round=1
engineA=llt1
engineB=llt2
games=01
wincauses=time forfeit:1
losscauses=time forfeit:1

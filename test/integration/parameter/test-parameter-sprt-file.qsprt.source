[each]
id=sprt-tournament
dir=.
proto=uci
tc=5+0.01
ponder=false
trace=none
restart=auto

[engine]
id=sprt-tournament
name=llt1
originalname=diagnostic-engine-lossontime
selected=true
author=volker boehm
cmd=test/integration/engines/diagnostic-engine-lossontime.exe
dir=.
proto=uci
trace=none
restart=auto

[engine]
id=sprt-tournament
name=llt2
originalname=diagnostic-engine-lossontime
selected=true
author=volker boehm
cmd=test/integration/engines/diagnostic-engine-lossontime.exe
dir=.
proto=uci
trace=none
restart=auto

[sprt]
id=sprt-tournament
alpha=0.05
beta=0.05
maxgames=2

[openings]
id=sprt-tournament
file=test/opening/8ply-1000+-0,4+.pgn

[pgnoutput]
id=sprt-tournament
file=test/integration/log/parameter/test.pgn

[draw]
id=sprt-tournament
active=false
movenumber=40
movecount=10
score=20

[resign]
id=sprt-tournament
active=false
movecount=10
score=600
twosided=true
